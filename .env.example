# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite for dev, Supabase for prod)
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Active AI Provider Keys ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Future Provider Keys (uncomment when activating) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=

# Default AI Provider
DEFAULT_AI_PROVIDER=gemini
DEFAULT_AI_MODEL=gemini-2.0-flash

# Cache (optional Redis)
# REDIS_URL=redis://localhost:6379/0

# Supabase (production)
SUPABASE_URL=
SUPABASE_KEY=
